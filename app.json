{
  "expo": {
    "name": "GEMBA 5S",
    "slug": "gemba-5s",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gemba5s",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemba.app5s"
    },
    "android": {
      "package": "com.gemba.app5s"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
