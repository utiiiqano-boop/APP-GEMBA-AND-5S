{
  "expo": {
    "name": "GEMBA 5S",
    "slug": "gemba-5s",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gemba5s",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemba.app5s"
    },
    "android": {
      "package": "com.gemba.app5s",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
